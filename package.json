{
  "name": "colorful-life-backend",
  "version": "1.0.0",
  "description": "Colorful Life Ltd backend foundation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p .",
    "start": "node dist/index.js",
    "start:local-http": "node dist/localHttp.js",
    "test": "npm run build && node dist/testing/runTests.js run",
    "test:db:check": "npm run build && node dist/testing/runTests.js check",
    "test:db:prepare": "npm run build && node dist/testing/runTests.js prepare",
    "test:safety": "npm run build && node --test dist/__tests__/testDatabaseSafety.test.js",
    "test:deployment-contracts": "node --test scripts/migration-contract_test.mjs scripts/recovery-contract_test.mjs",
    "generate:client": "node scripts/generate-client.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1123.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "4.22.3",
    "file-type": "^22.1.0",
    "fontkit": "^2.0.4",
    "jsonwebtoken": "^9.0.0",
    "multer": "2.5.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.20.2",
    "stripe": "^22.6.1",
    "unpdf": "^1.8.1",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/fontkit": "^2.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.10.9",
    "@typescript/typescript-linux-x64": "^7.0.2",
    "mailparser": "^3.9.40",
    "prisma": "7.10.1",
    "typescript": "^5.5.4"
  }
}
