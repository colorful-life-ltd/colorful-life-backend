generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma-client"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ListingCondition {
  NEW
  USED_LIKE_NEW
}

enum UsedOfferLifecycle {
  AVAILABLE
  SOLD
  RETIRED
}

enum OrderStatus {
  PENDING
  EXPIRED
  CONFIRMED
  DISPATCHED
  COMPLETED
  CANCELLED
  RETURNED
}

// -----------------------------------------------------------------------------
// Payment domain enums
// -----------------------------------------------------------------------------
enum PaymentProvider {
  MANUAL
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  PROCESSING
  FAILED
  CANCELED
}

enum RefundProvider {
  MANUAL
  STRIPE
  PAYPAL
}

enum RefundStatus {
  SUCCEEDED
  FAILED
  PROCESSING
}

// Cancellation metadata enums
enum CancellationInitiator {
  CUSTOMER
  SELLER
}

enum CancellationReason {
  CHANGED_MIND
  ORDERED_BY_MISTAKE
  ADDRESS_PROBLEM
  FOUND_CHEAPER_ELSEWHERE
  OTHER
  OUT_OF_STOCK
  PRICING_ERROR
  PRODUCT_UNAVAILABLE
  FULFILMENT_ISSUE
}

enum InventoryMovementType {
  PURCHASE_IN
  WEBSITE_SALE
  ORDER_RETURN
  ORDER_CANCELLATION_RETURN
  FBA_OUTBOUND
  DAMAGE_ADJUSTMENT
  MANUAL_ADJUSTMENT
  PURCHASE_RETURN_OUT
  CONDITION_ADJUSTMENT_SOURCE
  CONDITION_ADJUSTMENT_TARGET
  WRITE_OFF
}

enum InventoryAuditAction {
  CONDITION_ADJUSTMENT
  WRITE_OFF
}

enum InventoryAdjustmentReason {
  CUSTOMER_RETURN_DAMAGED
  OPENED_BOX
  PACKAGING_DAMAGE
  MISSING_PARTS
  WAREHOUSE_DAMAGE
  QUALITY_ISSUE
  OTHER
}

enum OrderReturnStatus {
  REQUESTED
  AUTHORIZED
  RECEIVED
  INSPECTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnReason {
  CHANGE_OF_MIND
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  OTHER
}

enum ReturnShippingPayer {
  CUSTOMER
  SELLER
}

enum ReturnCondition {
  AS_NEW
  OPENED_COMPLETE
  DAMAGED
  INCOMPLETE
  WRONG_ITEM_RETURNED
  OTHER
}

enum PurchaseItemDisposition {
  INVENTORY
  NON_INVENTORY
}

// -----------------------------------------------------------------------------
// Business expense domain enums
// -----------------------------------------------------------------------------
enum BusinessExpenseCategory {
  PURCHASE
  SHIPPING
  PLATFORM_FEE
  PACKAGING
  OTHER
}

enum BusinessExpenseSourceType {
  MANUAL
}

// -----------------------------------------------------------------------------
// BusinessExpense model
// -----------------------------------------------------------------------------
model BusinessExpense {
  id          Int                       @id @default(autoincrement())
  category    BusinessExpenseCategory
  amount      Decimal                   @db.Decimal(12, 2)
  incurredAt  DateTime
  description String?
  sourceType  BusinessExpenseSourceType
  sourceId    Int?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model User {
  id                     Int                     @id @default(autoincrement())
  email                  String                  @unique
  credentialVersion      String?
  passwordHash           String
  emailVerified          Boolean                 @default(false)
  role                   UserRole                @default(CUSTOMER)
  firstName              String?
  lastName               String?
  phone                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  addresses              Address[]
  inventoryMovements     InventoryMovement[]
  purchaseDocuments      PurchaseDocument[]
  orders                 Order[]
  orderReturns           OrderReturn[]
  inspectedOrderReturns  OrderReturn[]           @relation("OrderReturnInspectedBy")
  refunds                Refund[]
  inventoryAudits        InventoryAudit[]        @relation("InventoryAuditPerformedBy")
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
  refreshSessions        RefreshSession[]
  cart                   Cart?
}

model RefreshSession {
  id               Int       @id @default(autoincrement())
  userId           Int
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName    String
  line1            String
  line2            String?
  city             String
  county           String?
  postcode         String
  countryCode      String
  phone            String?
  isDefault        Boolean  @default(false)
  // Separate default billing flag, used for the new API.
  isDefaultBilling Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model LegoProduct {
  id                       Int              @id @default(autoincrement())
  setNumber                String           @unique
  // Nullable during the expand phase: historical orphan products have no listing-derived category.
  categoryId               Int?
  category                 Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title                    String
  description              String?
  theme                    String
  ageRecommendation        String
  pieceCount               Int
  isRetired                Boolean          @default(false)
  catalogueArtworkUrl      String?
  catalogueArtworkPublicId String?
  // The migration-managed partial unique index permits one featured product per Category.
  isFeatureProduct         Boolean          @default(false)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  productListings          ProductListing[]
  productImages            ProductImage[]

  @@index([theme])
  @@index([categoryId])
}

model Category {
  id                Int           @id @default(autoincrement())
  name              String        @unique
  subtitle          String?
  description       String?
  imageUrl          String?
  imagePublicId     String?
  thumbnailUrl      String?
  thumbnailPublicId String?
  legoProducts      LegoProduct[]
}

model ProductListing {
  id                    Int                  @id @default(autoincrement())
  legoProductId         Int
  legoProduct           LegoProduct          @relation(fields: [legoProductId], references: [id])
  condition             ListingCondition
  damageDescription     String?
  usedLifecycle         UsedOfferLifecycle?
  originalPrice         Decimal              @db.Decimal(10, 2)
  salePrice             Decimal?             @db.Decimal(10, 2)
  currentStock          Int                  @default(0)
  reservedStock         Int                  @default(0)
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  usedConditionPhotos   UsedConditionPhoto[]
  inventoryMovements    InventoryMovement[]
  purchaseItems         PurchaseItem[]
  orderItems            OrderItem[]
  cartItems             CartItem[]
  sourceInventoryAudits InventoryAudit[]     @relation("InventoryAuditSourceListing")
  targetInventoryAudits InventoryAudit[]     @relation("InventoryAuditTargetListing")

  @@index([legoProductId])
  @@index([condition])
  @@index([active])
}

model UsedConditionPhoto {
  id        Int            @id @default(autoincrement())
  listingId Int
  listing   ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  sortOrder Int
  createdAt DateTime       @default(now())

  @@unique([listingId, sortOrder])
  @@index([listingId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  orderProvenance OrderCartProvenance[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id               Int            @id @default(autoincrement())
  cartId           Int
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productListingId Int
  productListing   ProductListing @relation(fields: [productListingId], references: [id], onDelete: Restrict)
  quantity         Int
  orderAllocations OrderCartAllocation[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, productListingId])
  @@index([cartId])
  @@index([productListingId])
}

model ProductImage {
  id            Int         @id @default(autoincrement())
  legoProductId Int
  legoProduct   LegoProduct @relation(fields: [legoProductId], references: [id], onDelete: Cascade)
  url           String
  publicId      String
  altText       String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([legoProductId])
  @@index([legoProductId, sortOrder])
}

model InventoryMovement {
  id                Int                   @id @default(autoincrement())
  listingId         Int
  listing           ProductListing        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  quantityChange    Int
  type              InventoryMovementType
  note              String
  performedByUserId Int
  performedByUser   User                  @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime              @default(now())

  @@index([listingId])
  @@index([performedByUserId])
  @@index([createdAt])
  @@index([type])
}

model InventoryAudit {
  id                     Int                       @id @default(autoincrement())
  sourceProductListingId Int
  sourceProductListing   ProductListing            @relation("InventoryAuditSourceListing", fields: [sourceProductListingId], references: [id], onDelete: Restrict)
  targetProductListingId Int?
  targetProductListing   ProductListing?           @relation("InventoryAuditTargetListing", fields: [targetProductListingId], references: [id], onDelete: Restrict)
  action                 InventoryAuditAction
  quantity               Int
  reason                 InventoryAdjustmentReason
  reasonNote             String?
  performedByUserId      Int
  performedByUser        User                      @relation("InventoryAuditPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  createdAt              DateTime                  @default(now())

  @@index([sourceProductListingId])
  @@index([targetProductListingId])
  @@index([performedByUserId])
  @@index([createdAt])
}

model Order {
  id                   Int         @id @default(autoincrement())
  userId               Int
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status               OrderStatus @default(PENDING)
  creationIdempotencyKey String? @db.VarChar(128)
  creationRequestHash String? @db.VarChar(64)
  // Billing address snapshot – comes from the user's saved/default address
  billingRecipientName String
  billingLine1         String
  billingLine2         String?
  billingCity          String
  billingCounty        String?
  billingPostcode      String
  billingCountryCode   String
  billingPhone         String?

  // Delivery address snapshot – defaults to billing but can be overridden
  deliveryRecipientName String
  deliveryLine1         String
  deliveryLine2         String?
  deliveryCity          String
  deliveryCounty        String?
  deliveryPostcode      String
  deliveryCountryCode   String
  deliveryPhone         String?
  totalAmount           Decimal                @db.Decimal(12, 2)
  // Shipping details – only visible to admins
  actualShippingCost    Decimal?               @db.Decimal(10, 2)
  shippingCarrier       String?
  trackingNumber        String?
  dispatchedAt          DateTime?
  reservationExpiresAt  DateTime?
  createdAt             DateTime               @default(now())
  // Cancellation metadata – optional until cancellation occurs
  cancelledAt           DateTime?
  cancelledBy           CancellationInitiator?
  cancellationReason    CancellationReason?
  completedAt           DateTime?              @db.Timestamptz
  updatedAt             DateTime               @updatedAt
  orderItems            OrderItem[]
  payments              Payment[]
  refunds               Refund[]
  cartProvenance        OrderCartProvenance?
  paymentResolution     PaymentResolution?
  paymentAttempts       PaymentAttempt[]
  financialEvidence     FinancialEvidence[]
  reservationReleaseProofs ReservationReleaseProof[]

  @@unique([userId, creationIdempotencyKey])
  @@index([userId])
}

// No backfill: absence means there is no trustworthy cart provenance.
enum CartReconciliationState {
  ACTIVE
  CONSUME_PENDING
  RELEASE_PENDING
  CONSUMED
  RELEASED
}

model OrderCartProvenance {
  orderId Int @id
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cartId Int
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  state CartReconciliationState @default(ACTIVE)
  completedAt DateTime?
  lastError String?
  allocations OrderCartAllocation[]

  @@index([state, orderId])
  @@index([cartId, state])
}

model OrderCartAllocation {
  id Int @id @default(autoincrement())
  orderId Int
  provenance OrderCartProvenance @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  // Bound to a row identity, never to a listing recreated after removal.
  cartItemId Int?
  cartItem CartItem? @relation(fields: [cartItemId], references: [id], onDelete: SetNull)
  productListingId Int
  quantity Int
  visibleQuantity Int

  @@unique([orderId, productListingId])
  @@index([cartItemId])
}

// -----------------------------------------------------------------------------
// Payment domain model
// -----------------------------------------------------------------------------
model Payment {
  id                       Int             @id @default(autoincrement())
  orderId                  Int
  order                    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount                   Decimal         @db.Decimal(12, 2)
  currency                 String          @default("GBP") @db.VarChar(3)
  provider                 PaymentProvider @default(MANUAL)
  providerReference        String
  idempotencyKey           String?         @unique
  providerCaptureReference String?
  captureIdempotencyKey    String?         @unique
  status                   PaymentStatus   @default(PENDING)
  paidAt                   DateTime?
  refundedAmount           Decimal         @default(0) @db.Decimal(12, 2)
  reservedRefundAmount     Decimal         @default(0) @db.Decimal(12, 2)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  refunds                  Refund[]
  attempts                 PaymentAttempt[]

  @@unique([provider, providerReference])
  @@unique([provider, providerCaptureReference])
  @@unique([orderId])
  @@index([orderId])
}

model PaymentWebhookEvent {
  id              Int             @id @default(autoincrement())
  provider        PaymentProvider
  providerEventId String
  eventType       String
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  processingError String?
  evidence        Json?
  financialEvidence FinancialEvidence[]

  @@unique([provider, providerEventId])
  @@index([receivedAt])
  @@index([provider, processedAt, id])
}

model Refund {
  id                   Int            @id @default(autoincrement())
  orderId              Int
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId            Int
  payment              Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount               Decimal        @db.Decimal(12, 2)
  currency             String         @db.VarChar(3)
  status               RefundStatus   @default(SUCCEEDED)
  provider             RefundProvider @default(MANUAL)
  providerReference    String
  refundIdempotencyKey String?        @unique
  reason               String?
  performedByUserId    Int
  performedByUser      User           @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([paymentId])
  @@index([performedByUserId])
  @@index([createdAt])
}

model OrderItem {
  id                        Int               @id @default(autoincrement())
  orderId                   Int
  order                     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productListingId          Int
  productListing            ProductListing    @relation(fields: [productListingId], references: [id], onDelete: Restrict)
  quantity                  Int
  returnedQuantity          Int               @default(0)
  reservedReturnQuantity    Int               @default(0)
  unitPrice                 Decimal           @db.Decimal(10, 2)
  lineTotal                 Decimal           @db.Decimal(12, 2)
  conditionSnapshot         ListingCondition?
  damageDescriptionSnapshot String?
  conditionPhotoSnapshot    Json?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  returns                   OrderReturn[]

  @@index([orderId])
  @@index([productListingId])
}

model OrderReturn {
  id                 Int                  @id @default(autoincrement())
  orderItemId        Int
  orderItem          OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity           Int
  restockQuantity    Int                  @default(0)
  reason             ReturnReason
  reasonNote         String?
  status             OrderReturnStatus    @default(REQUESTED)
  shippingPayer      ReturnShippingPayer?
  returnShippingCost Decimal?             @db.Decimal(10, 2)
  performedByUserId  Int
  performedByUser    User                 @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  condition          ReturnCondition?
  inspectionNote     String?
  inspectedAt        DateTime?
  inspectedByUserId  Int?
  inspectedByUser    User?                @relation("OrderReturnInspectedBy", fields: [inspectedByUserId], references: [id], onDelete: Restrict)
  requestedAt        DateTime             @default(now())
  authorizedAt       DateTime?
  receivedAt         DateTime?
  completedAt        DateTime?
  rejectedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([orderItemId])
  @@index([status])
  @@index([performedByUserId])
  @@index([inspectedByUserId])
  @@index([requestedAt])
}

model Purchase {
  id                   Int                @id @default(autoincrement())
  sourceOrderReference String             @unique
  sourceOrderDate      DateTime?
  merchantName         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  purchaseDocuments    PurchaseDocument[]
}

model PurchaseDocument {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  partNumber             Int
  sourceInvoiceReference String?
  importHash             String    @unique @db.VarChar(64)
  sourceDocumentDate     DateTime?

  importedByUserId Int
  importedByUser   User @relation(fields: [importedByUserId], references: [id], onDelete: Restrict)

  originalGrossMerchandiseTotal Decimal @db.Decimal(12, 2)
  shippingTotal                 Decimal @default(0.00) @db.Decimal(12, 2)
  discountTotal                 Decimal @default(0.00) @db.Decimal(12, 2)
  finalTotalPaid                Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseItems PurchaseItem[]

  @@unique([purchaseId, partNumber])
  @@index([purchaseId])
  @@index([importedByUserId])
}

model PurchaseItem {
  id Int @id @default(autoincrement())

  purchaseDocumentId Int
  purchaseDocument   PurchaseDocument @relation(fields: [purchaseDocumentId], references: [id], onDelete: Restrict)

  productListingId     Int?
  productListing       ProductListing?         @relation(fields: [productListingId], references: [id], onDelete: SetNull)
  inventoryDisposition PurchaseItemDisposition @default(INVENTORY)

  externalProductId String?
  sourceDescription String
  sourceSetNumber   String?
  sourceLineNumber  Int?

  quantity Int

  originalGrossUnitCost  Decimal @db.Decimal(12, 2)
  originalGrossLineTotal Decimal @db.Decimal(12, 2)

  allocatedShipping Decimal @default(0.00) @db.Decimal(12, 2)
  allocatedDiscount Decimal @default(0.00) @db.Decimal(12, 2)

  finalLineCost Decimal @db.Decimal(12, 2)
  finalUnitCost Decimal @db.Decimal(14, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivedAt DateTime?

  // Timestamp marking when this item was returned to the supplier.
  returnedAt DateTime?

  @@index([purchaseDocumentId])
  @@index([productListingId])
  @@index([externalProductId])
  @@index([sourceSetNumber])
}

// Phase 2A: dormant foundation. Historical UNKNOWN never implies provider finality.
enum ReservationDisposition {
  HELD
  CONSUMED
  RELEASED
}
enum PaymentResolutionState {
  INITIAL_OPEN
  INITIAL_WAIT
  RETRY_OPEN
  CLOSED_RESOLVING
  SAFETY_HOLD
  PAID
  RELEASED
  REVIEW_REQUIRED
}
enum PaymentOperationType {
  CREATE
  CONFIRM
  CAPTURE
  TERMINATE
  RETRIEVE
}
enum PaymentOperationState {
  PREPARED
  POTENTIALLY_DISPATCHED
  RESULT_RECORDED
  UNKNOWN
}
enum FinancialEvidenceKind {
  HISTORICAL_UNVERIFIED
  FAILURE
  SUCCESS
  TERMINAL_UNPAID
}
model PaymentAttempt {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId Int
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider PaymentProvider
  amount Decimal @db.Decimal(12, 2)
  currency String @db.VarChar(3)
  providerReference String?
  providerCaptureReference String?
  creationKey String? @unique
  admittedAt DateTime? @db.Timestamptz(3)
  historical Boolean @default(false)
  successEvidenceId Int?
  successEvidence FinancialEvidence? @relation("AttemptSuccess", fields: [successEvidenceId], references: [id], onDelete: Restrict)
  finalityEvidenceId Int?
  finalityEvidence FinancialEvidence? @relation("AttemptFinality", fields: [finalityEvidenceId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  operations PaymentOperation[]
  @@unique([provider, providerReference])
  @@unique([provider, providerCaptureReference])
  @@index([orderId, id])
  @@index([paymentId])
}
model PaymentOperation {
  id Int @id @default(autoincrement())
  attemptId Int
  attempt PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type PaymentOperationType
  operationKey String @unique @db.VarChar(128)
  requestHash String? @db.VarChar(64)
  admittedAt DateTime? @db.Timestamptz(3)
  historical Boolean @default(false)
  state PaymentOperationState @default(PREPARED)
  evidenceId Int?
  evidence FinancialEvidence? @relation("OperationResult", fields: [evidenceId], references: [id], onDelete: Restrict)
  sourceEvidence FinancialEvidence[] @relation("OperationSource")
  failureResolutions PaymentResolution[]
  admissionDeadline DateTime? @db.Timestamptz(3)
  claimOwner String? @db.VarChar(128)
  claimGeneration Int @default(0)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  executionCount Int @default(0)
  nextCheckAt DateTime? @db.Timestamptz(3)
  lastErrorCode String? @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([state, nextCheckAt, id])
  @@index([attemptId, id])
}
model FinancialEvidence {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider PaymentProvider
  evidenceKey String @db.VarChar(256)
  kind FinancialEvidenceKind
  // Allowlisted normalized evidence only; never credentials or raw provider payloads.
  normalized Json
  verifiedAt DateTime? @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  webhookEventId Int?
  webhookEvent PaymentWebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)
  successfulAttempts PaymentAttempt[] @relation("AttemptSuccess")
  finalAttempts PaymentAttempt[] @relation("AttemptFinality")
  operations PaymentOperation[] @relation("OperationResult")
  operationId Int?
  operation PaymentOperation? @relation("OperationSource", fields: [operationId], references: [id], onDelete: Restrict)
  releaseProofs ReservationReleaseProof[]
  failureResolutions PaymentResolution[]
  @@unique([provider, evidenceKey])
  @@index([orderId, id])
}
enum ReservationReleaseProofType {
  NO_PAYMENT
  PROVIDER_FINALITY
}
model ReservationReleaseProof {
  id Int @id @default(autoincrement())
  orderId Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type ReservationReleaseProofType @default(PROVIDER_FINALITY)
  evidenceId Int?
  evidence FinancialEvidence? @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  decisionVersion Int
  // Immutable IDs/snapshot of covered attempts and operations, validated by Phase 2B.
  coverage Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  resolution PaymentResolution?
  @@index([orderId, id])
}
model PaymentResolution {
  orderId Int @id
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  state PaymentResolutionState @default(INITIAL_OPEN)
  orderCreatedAt DateTime @db.Timestamptz(3)
  initialPaymentDeadline DateTime @db.Timestamptz(3)
  firstFailureVerifiedAt DateTime? @db.Timestamptz(3)
  retryDeadline DateTime? @db.Timestamptz(3)
  firstFailureOperationId Int?
  firstFailureOperation PaymentOperation? @relation(fields: [firstFailureOperationId], references: [id], onDelete: Restrict)
  firstFailureEvidenceId Int?
  firstFailureEvidence FinancialEvidence? @relation(fields: [firstFailureEvidenceId], references: [id], onDelete: Restrict)
  paymentAdmissionClosedAt DateTime? @db.Timestamptz(3)
  closureReason String? @db.VarChar(100)
  reservationDisposition ReservationDisposition?
  dispositionAt DateTime? @db.Timestamptz(3)
  releaseProofId Int? @unique
  releaseProof ReservationReleaseProof? @relation(fields: [releaseProofId], references: [id], onDelete: Restrict)
  resolutionNextCheckAt DateTime? @db.Timestamptz(3)
  escalatedAt DateTime? @db.Timestamptz(3)
  quarantineReason String? @db.VarChar(200)
  historical Boolean @default(false)
  @@index([state, resolutionNextCheckAt, orderId])
}

// Shared fixed-window password recovery counters; keys are HMACs, not personal data.
model PasswordRecoveryLimit {
  key String @id @db.VarChar(64)
  windowStartedAt DateTime @db.Timestamptz(3)
  count Int
  @@index([windowStartedAt])
}
