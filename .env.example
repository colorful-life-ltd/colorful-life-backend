PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/colorful_life
# Required for tests only. Use a dedicated database and preferably a test-only role.
# Never point this at the development or production database.
TEST_DATABASE_URL=postgres://test_user:test_password@localhost:5432/colorful_life_test
JWT_SECRET=supersecret
JWT_EXPIRES_IN=1h
REFRESH_SESSION_TTL_DAYS=30
AWS_REGION=eu-west-2
SES_FROM_EMAIL=noreply@example.com
FRONTEND_URL=http://localhost:3000
# Canonical public storefront origin for /sitemap.xml (no path). Sitemap returns 503 when unset.
PUBLIC_SITE_URL=
IDEAL_POSTCODES_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
