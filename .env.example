PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/colorful_life
# Required for tests only. Use a dedicated database and preferably a test-only role.
# Never point this at the development or production database.
TEST_DATABASE_URL=postgres://test_user:test_password@localhost:5432/colorful_life_test
JWT_SECRET=supersecret
JWT_EXPIRES_IN=1h
REFRESH_SESSION_TTL_DAYS=30
AWS_REGION=eu-west-2
SES_FROM_EMAIL=noreply@example.com
FRONTEND_URL=http://localhost:3000
# Canonical public storefront origin for /sitemap.xml (no path). Sitemap returns 503 when unset.
PUBLIC_SITE_URL=
IDEAL_POSTCODES_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# New durable email mechanisms are independently opt-in. No production flag is enabled here.
ORDER_CONFIRMATION_EMAIL_ENABLED=false
DISPATCH_CONFIRMATION_EMAIL_ENABLED=false
# With durable dispatch false, the existing best-effort dispatch sender is preserved.
# Each enabled durable type requires its own fixed, approved, non-future activation cutoff:
# ORDER_CONFIRMATION_EMAIL_ACTIVE_FROM and DISPATCH_CONFIRMATION_EMAIL_ACTIVE_FROM are unset.
# ORDER_CONFIRMATION_BUSINESS_JSON is unset. See docs/order-confirmation-email.md.

# Issue #194: independently opt-in NEW initiation only. Webhooks/refunds/recovery stay enabled.
# Public self-registration (POST /auth/signup). Keep false until launch.
REGISTRATION_ENABLED=false
PAYMENT_STRIPE_INITIATION_ENABLED=false
PAYMENT_PAYPAL_INITIATION_ENABLED=false
# Required shared secret (>=32 chars), supplied through deployment secrets; no value here.
# PAYMENT_ABUSE_HMAC_SECRET=
# Optional staging-limit overrides; see docs/security/payment-abuse-protection.md.
# PAYMENT_ABUSE_LIMITS_JSON={"provider":[100,900]}
PAYMENT_CHALLENGE_ENABLED=false
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAME=shop.example.com

# Required explicit topology choice in production: direct or proxy.
# Proxy mode also requires explicit validated TRUSTED_PROXY_CIDRS; never use /0.
# CLIENT_IP_MODE=proxy
# TRUSTED_PROXY_CIDRS=
# Outside tests missing abuse secret or malformed limit overrides fail startup.
# Enable each provider deliberately only after its documented acceptance checklist.

# Development-only localhost default. Production requires explicit HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set false on API-only ECS tasks; separately run supervised worker tasks.
BACKGROUND_WORKERS_ENABLED=true
# Production requires PAYMENT_RESOLUTION_ENABLED=true and an unpredictable >=32-byte JWT_SECRET.
# Do not copy this example's development credentials into production.

# Mandatory when NODE_ENV=production: staging permits test providers only; production permits live providers only.
DEPLOYMENT_ENVIRONMENT=staging
