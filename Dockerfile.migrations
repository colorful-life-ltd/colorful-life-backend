FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS dependencies
WORKDIR /app
COPY package*.json ./
COPY scripts/prune-migration-dependencies.mjs /tmp/prune-migration-dependencies.mjs
RUN npm ci && node /tmp/prune-migration-dependencies.mjs && npm prune --omit=dev --omit=peer --omit=optional

FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
RUN rm -rf /usr/local/lib/node_modules /opt/yarn-* && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /app/package.json ./package.json
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY src/config/testDatabase.ts ./src/config/testDatabase.ts
COPY src/config/database.ts ./src/config/database.ts
COPY certs ./certs
COPY scripts ./scripts
RUN sha256sum -c certs/SHA256SUMS
USER node
CMD ["node","scripts/migrate.mjs","status"]
