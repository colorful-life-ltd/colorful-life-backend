{
  "family": "REPLACE-backend",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "REPLACE-execution-role",
  "taskRoleArn": "REPLACE-minimal-runtime-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "REPLACE-immutable-image-digest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "stopTimeout": 30,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "BACKGROUND_WORKERS_ENABLED",
          "value": "false"
        },
        {
          "name": "PAYMENT_RESOLUTION_ENABLED",
          "value": "true"
        },
        {
          "name": "PAYMENT_STRIPE_INITIATION_ENABLED",
          "value": "false"
        },
        {
          "name": "PAYMENT_PAYPAL_INITIATION_ENABLED",
          "value": "false"
        },
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "REPLACE-HTTPS-STOREFRONT-ORIGIN"
        },
        {
          "name": "FRONTEND_URL",
          "value": "REPLACE-HTTPS-STOREFRONT-ORIGIN"
        },
        {
          "name": "SES_FROM_EMAIL",
          "value": "REPLACE-APPROVED-SENDER"
        },
        {
          "name": "CLIENT_IP_MODE",
          "value": "proxy"
        },
        {
          "name": "TRUSTED_PROXY_CIDRS",
          "value": "REPLACE-ALB-SUBNET-CIDRS"
        },
        {
          "name": "DEPLOYMENT_ENVIRONMENT",
          "value": "REPLACE-staging-or-production"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "REPLACE-secretsmanager-arn"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "REPLACE-SPECIFIC-SECRET-ARN"
        },
        {
          "name": "PAYMENT_ABUSE_HMAC_SECRET",
          "valueFrom": "REPLACE-SPECIFIC-SECRET-ARN"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "REPLACE",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "api"
        }
      },
      "healthCheck": {
        "command": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
