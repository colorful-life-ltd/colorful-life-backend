{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApprovedSesSenderOnly",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "arn:aws:ses:REPLACE_REGION:REPLACE_ACCOUNT:identity/REPLACE_VERIFIED_IDENTITY",
      "Condition": {"StringEquals": {"ses:FromAddress": "REPLACE_APPROVED_FROM_ADDRESS"}}
    },
    {
      "Sid": "SesReadinessOnly",
      "Effect": "Allow",
      "Action": ["ses:GetAccountSendingEnabled", "ses:GetSendQuota", "ses:GetIdentityVerificationAttributes"],
      "Resource": "*"
    }
  ]
}
